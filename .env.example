# Gemini API key for function embeddings. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq API key for the agent's tool-calling reasoning loop. Get one from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# LangSearch API key for optional web-search integrations. Get one from https://langsearch.com/api-keys
LANGSEARCH_API_KEY=your-langsearch-api-key

# Optional PostgreSQL connection string. Leave this blank/unset to use local SQLite.
DATABASE_URL=postgresql://username:password@localhost:5432/sementic_cb_search
